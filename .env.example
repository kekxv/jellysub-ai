# JellySub-AI 环境变量配置
# 复制此文件为 .env 并填写实际值

# --- 管理后台认证 ---
# 必填。不要使用示例值；为每个部署选择独立凭据。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# TOTP 共享密钥（使用 pyotp.random_base32() 生成，或在 Authenticator App 中配置）
# 留空则跳过 TOTP 验证
TOTP_SECRET=

# --- Webhook 签名校验 ---
# Jellyfin Webhook 中设置的共享密钥，用于验证请求来源
WEBHOOK_SECRET=

# --- Session 签名密钥 ---
# 必须至少 32 个随机字符（例如：uv run python -c "import secrets; print(secrets.token_urlsafe(32))"）
SESSION_SECRET=

# 通过 HTTPS 提供服务时设为 true，令浏览器只通过 HTTPS 发送 session cookie
SESSION_HTTPS_ONLY=true

# --- 模型下载源 ---
# huggingface (默认) | modelscope (使用 ModelScope 下载，自动配置 HF_ENDPOINT=hf-mirror.com)
# 设置 MODEL_SOURCE=modelscope 时，会自动从 modelscope.cn 下载模型到 ./model_cache
MODEL_SOURCE=
