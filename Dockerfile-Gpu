FROM ghcr.io/astral-sh/uv:0.11.30@sha256:93b61e21202b1dab861092748e46bbd6e0e41dd84f59b9174efd2353186e1b47 AS uv

# 注意：builder 使用 CUDA runtime 镜像而非 toolkit (devel) 镜像。
# torch/torchaudio 均为 PyPI 预编译 wheel，构建不需要 nvcc；
# 若未来引入需从源码编译 CUDA 扩展的包，需换用 devel 镜像并安装 CUDA toolkit。
FROM nvidia/cuda:12.8.1-runtime-ubuntu24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libsox-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /bin/

WORKDIR /app

COPY docker/gpu/pyproject.toml docker/gpu/uv.lock ./

ENV UV_COMPILE_BYTECODE=1 \
    UV_HTTP_TIMEOUT=600 \
    UV_LINK_MODE=copy

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-install-project --python /usr/bin/python3 \
    && rm -rf \
        /app/.venv/lib/python*/site-packages/torch/test \
        /app/.venv/lib/python*/site-packages/torch/include \
        /app/.venv/lib/python*/site-packages/gradio \
        /app/.venv/lib/python*/site-packages/gradio_client

FROM nvidia/cuda:12.8.1-runtime-ubuntu24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000 \
    MODEL_SOURCE="" \
    MODEL_IDLE_TIMEOUT=180 \
    PYTHONPATH=/app \
    PATH="/app/.venv/bin:$PATH" \
    CONFIG_PATH=/data/config.json \
    TASK_DB_PATH=/data/tasks.db \
    MODEL_CACHE=/data/model_cache \
    TEMP_DIR=/data/tmp

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libsox3 \
    python3 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --no-create-home app \
    && mkdir -p /app /data/model_cache /data/tmp \
    && chown -R app:app /data

COPY --from=builder /app/.venv /app/.venv
COPY main.py config.py env_config.py /app/
COPY core /app/core
COPY static /app/static

VOLUME ["/data"]
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=3)"

USER app
WORKDIR /data

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
